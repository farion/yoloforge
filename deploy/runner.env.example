# Absolute paths required. Keep this file private; the token itself is separate.
FACTORY_SERVER=http://127.0.0.1:7432
FACTORY_RUNNER_ID=REPLACE_WITH_STABLE_UUID
FACTORY_RUNNER_NAME=laptop
FACTORY_RUNNER_LOCATION=local
FACTORY_TOKEN_FILE=/home/USER/.config/yolofactory/runner.token
FACTORY_JOURNAL=/home/USER/.local/share/yolofactory/runner.sqlite3
FACTORY_REPOSITORIES=/home/USER/.config/yolofactory/repositories.json
FACTORY_WORKSPACE_ROOT=/home/USER/.local/share/yolofactory/workspaces
FACTORY_OPENCODE_REGISTRATION=/home/USER/.local/share/opencode/service.json
